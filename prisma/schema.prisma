generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  type          String
  path          String?
  referrer      String?
  seriesId      String?
  seriesTitle   String?
  episodeId     String?
  episodeNumber Int?
  label         String?
  sessionId     String?
  visitorId     String?
  ip            String?
  country       String?
  countryCode   String?
  city          String?
  region        String?
  userAgent     String?
  device        String?
  browser       String?
  meta          String?

  @@index([createdAt])
  @@index([type])
  @@index([seriesId])
  @@index([countryCode])
  @@index([visitorId])
  @@index([sessionId])
}
